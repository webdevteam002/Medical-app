# Database
DATABASE_URL="postgresql://medstudy:medstudy@localhost:5433/medstudy?schema=public"

# JWT (use 64+ random chars in production)
JWT_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=medstudy-pdfs

# JazzCash / Easypaisa manual payments (shown in app paywall)
PAYMENT_JAZZCASH_NUMBER=
PAYMENT_EASYPAISA_NUMBER=
PAYMENT_BANK_DETAILS=
PAYMENT_WHATSAPP_NUMBER=
PAYMENT_INSTRUCTIONS=Send payment then WhatsApp screenshot. Access activated within 24 hours.

# Production SSL pinning (comma-separated SHA-256 pins for Flutter)
SSL_PIN_SHA256=
API_PUBLIC_DOMAIN=api.yourdomain.com
