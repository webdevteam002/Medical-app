# Database
DATABASE_URL="postgresql://medstudy:medstudy@localhost:5433/medstudy?schema=public"

# JWT (use 64+ random chars in production)
JWT_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=medstudy-pdfs

# JazzCash / Easypaisa manual payments (shown in app paywall)
PAYMENT_JAZZCASH_NUMBER=03XX-XXXXXXX
PAYMENT_EASYPAISA_NUMBER=03XX-XXXXXXX
PAYMENT_BANK_DETAILS=Bank Name, Account Title, IBAN
PAYMENT_WHATSAPP_NUMBER=92XXXXXXXXXX
PAYMENT_INSTRUCTIONS=Send payment then WhatsApp screenshot with your registered email. Access activated within 24 hours.

# Gemini live exam grading (EXAM_GRADING_MODE=ai)
# Get a key: https://aistudio.google.com/apikey
EXAM_GRADING_MODE=ai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# MedStudy AI-0 / AI-1 (MCQ explanation) — separate from exam grading
# Keep AI_ENABLED=false until keys and quotas are configured in production.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_TIMEOUT_MS=18000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_EXPLANATION_LIMIT=20

# MedStudy AI-2 Medical RAG (pgvector). Keep disabled until pgvector + keys ready.
# Embedding model/dimensions MUST match migration vector(N) and each other.
# Changing model or dimensions requires full reindex of ACTIVE documents.
AI_RAG_ENABLED=false
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_RAG_TOP_K=6
AI_RAG_CHUNK_SIZE=650
AI_RAG_CHUNK_OVERLAP=80
AI_RAG_MAX_DOCUMENT_SIZE=26214400
AI_RAG_EMBED_BATCH_SIZE=16
AI_DAILY_CHAT_LIMIT=40
AI_CHAT_HISTORY_LIMIT=8
AI_CHAT_MAX_MESSAGE_CHARS=2000
# AI-5 admin MCQ verification (advisory; never auto-edits questions)
AI_DAILY_ADMIN_VERIFY_LIMIT=40

# AI-7/8: production refuses AI_ENABLED=true without GEMINI_API_KEY.
# Keep AI_EMBEDDING_DIMENSIONS=768 unless you migrate pgvector width + reindex.
# See docs/AI_PRODUCTION.md

# Production SSL pinning (comma-separated SHA-256 pins for Flutter)
SSL_PIN_SHA256=
API_PUBLIC_DOMAIN=api.yourdomain.com

# Public API origin for local-storage material stream URLs (no trailing /v1)
PUBLIC_API_BASE_URL=http://92.5.56.120:3000

