generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum DeviceType {
  MOBILE
  DESKTOP
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PlanType {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  FCPS_PART_1
  FCPS_PART_2
  ALL_MBBS
  ULTIMATE_BUNDLE
}

enum MaterialType {
  PDF
  VIDEO
  NOTES
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(STUDENT)
  isBanned     Boolean  @default(false) @map("is_banned")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deviceSessions   DeviceSession[]
  subscriptions    Subscription[]
  examAttempts     ExamAttempt[]
  bookmarks        Bookmark[]
  screenshotEvents ScreenshotEvent[]
  aiUsageEvents    AiUsageEvent[]
  aiConversations  AiConversation[]
  aiVerificationsCreated AiQuestionVerification[] @relation("AiVerificationCreatedBy")
  aiVerificationsDecided AiQuestionVerification[] @relation("AiVerificationDecidedBy")

  @@map("users")
}

model DeviceSession {
  id               String     @id @default(uuid())
  userId           String     @map("user_id")
  deviceId         String     @map("device_id")
  deviceName       String     @map("device_name")
  deviceType       DeviceType @default(MOBILE) @map("device_type")
  refreshTokenHash String     @map("refresh_token_hash")
  isActive         Boolean  @default(true) @map("is_active")
  lastActiveAt     DateTime @default(now()) @map("last_active_at")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_sessions")
}

model SubscriptionPlan {
  id                  String   @id @default(uuid())
  name                String
  planType            PlanType @unique @map("plan_type")
  pricePkr            Int      @map("price_pkr")
  durationDays        Int      @default(365) @map("duration_days")
  revenuecatProductId String?  @map("revenuecat_product_id")
  isActive            Boolean  @default(true) @map("is_active")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(PENDING)
  startDate            DateTime?          @map("start_date")
  endDate              DateTime?          @map("end_date")
  revenuecatSubscriberId String?            @map("revenuecat_subscriber_id")
  createdAt            DateTime           @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

model Year {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @map("sort_order")
  planType  PlanType @map("plan_type")

  subjects Subject[]

  @@map("years")
}

model Subject {
  id        String @id @default(uuid())
  yearId    String @map("year_id")
  name      String
  slug      String
  sortOrder Int    @map("sort_order")

  year      Year       @relation(fields: [yearId], references: [id], onDelete: Cascade)
  topics    Topic[]
  materials Material[]
  questions Question[]
  exams     Exam[]

  @@index([yearId])
  @@unique([yearId, slug])
  @@map("subjects")
}

model Topic {
  id        String @id @default(uuid())
  subjectId String @map("subject_id")
  name      String
  sortOrder Int    @map("sort_order")

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materials Material[]

  @@index([subjectId])
  @@map("topics")
}

model Material {
  id               String       @id @default(uuid())
  subjectId        String       @map("subject_id")
  topicId          String?      @map("topic_id")
  title            String
  type             MaterialType @default(PDF)
  fileKey          String       @map("file_key")
  fileSizeBytes    BigInt       @default(0) @map("file_size_bytes")
  isDownloadable   Boolean      @default(true) @map("is_downloadable")
  isPublished      Boolean      @default(false) @map("is_published")
  /// Copyright/AI governance gate — default deny. Admin-only mutation.
  aiIngestAllowed  Boolean      @default(false) @map("ai_ingest_allowed")
  isPastPaper      Boolean      @default(false) @map("is_past_paper")
  pastPaperYear    Int?         @map("past_paper_year")
  pastPaperSession String?      @map("past_paper_session")
  createdAt        DateTime     @default(now()) @map("created_at")

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic       Topic?       @relation(fields: [topicId], references: [id])
  bookmarks   Bookmark[]
  aiDocuments AiDocument[]

  @@index([subjectId])
  @@index([topicId])
  @@index([isPublished, subjectId])
  @@index([aiIngestAllowed, isPublished])
  @@map("materials")
}

model Question {
  id              String     @id @default(uuid())
  subjectId       String     @map("subject_id")
  stem            String
  options         Json
  correctOptionId String     @map("correct_option_id")
  explanation     String
  difficulty      Difficulty @default(MEDIUM)
  tags            Json       @default("[]")
  imageKey        String?    @map("image_key")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at")

  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examQuestions       ExamQuestion[]
  examAttemptDetails  ExamAttemptDetail[]
  aiVerifications     AiQuestionVerification[]

  @@index([subjectId])
  @@index([subjectId, isPublished])
  @@map("questions")
}

model Exam {
  id               String   @id @default(uuid())
  title            String
  subjectId        String   @map("subject_id")
  durationMinutes  Int      @map("duration_minutes")
  questionCount    Int      @map("question_count")
  shuffleQuestions Boolean  @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean  @default(false) @map("shuffle_options")
  isPublished      Boolean  @default(false) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")

  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@index([subjectId])
  @@index([isPublished, subjectId])
  @@map("exams")
}

model ExamQuestion {
  examId     String @map("exam_id")
  questionId String @map("question_id")
  sortOrder  Int    @map("sort_order")

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  examId      String        @map("exam_id")
  status      AttemptStatus @default(IN_PROGRESS)
  score       Int?
  total       Int?
  percentage  Decimal?      @db.Decimal(5, 2)
  startedAt   DateTime      @default(now()) @map("started_at")
  completedAt DateTime?     @map("completed_at")

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  details ExamAttemptDetail[]

  @@index([userId, examId])
  @@map("exam_attempts")
}

model ExamAttemptDetail {
  id                 String  @id @default(uuid())
  attemptId          String  @map("attempt_id")
  questionId         String  @map("question_id")
  selectedOptionId   String? @map("selected_option_id")
  isCorrect          Boolean @default(false) @map("is_correct")
  timeSpentSeconds   Int     @default(0) @map("time_spent_seconds")
  aiCorrectOptionId  String? @map("ai_correct_option_id")
  aiExplanation      String? @map("ai_explanation") @db.Text
  gradedBy           String  @default("key") @map("graded_by") // "ai" | "key"

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("exam_attempt_details")
}

model Bookmark {
  userId     String   @map("user_id")
  materialId String   @map("material_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([userId, materialId])
  @@map("bookmarks")
}

model ScreenshotEvent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  screen    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("screenshot_events")
}

/// AI-0 usage telemetry + daily quota accounting (no prompt/content payloads).
model AiUsageEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  endpoint     String
  provider     String
  model        String
  success      Boolean  @default(false)
  latencyMs    Int      @default(0) @map("latency_ms")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endpoint, createdAt])
  @@index([endpoint, createdAt])
  @@map("ai_usage_events")
}

enum AiDocumentStatus {
  PENDING
  PROCESSING
  ACTIVE
  STALE
  FAILED
  OCR_REQUIRED
}

/// AI-2 indexed material version (RAG corpus). Only ACTIVE is retrieved.
model AiDocument {
  id                 String           @id @default(uuid())
  materialId         String           @map("material_id")
  contentHash        String           @map("content_hash")
  status             AiDocumentStatus @default(PENDING)
  embeddingModel     String           @map("embedding_model")
  embeddingDimensions Int             @map("embedding_dimensions")
  chunkCount         Int              @default(0) @map("chunk_count")
  errorCode          String?          @map("error_code")
  errorMessage       String?          @map("error_message") @db.Text
  indexedAt          DateTime?        @map("indexed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  material Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chunks   AiDocumentChunk[]

  @@index([materialId, status])
  @@index([status, materialId])
  @@index([contentHash])
  @@map("ai_documents")
}

/// AI-2 page-aware chunk + embedding. Vector stored via pgvector (Unsupported in Prisma).
model AiDocumentChunk {
  id          String                       @id @default(uuid())
  documentId  String                       @map("document_id")
  materialId  String                       @map("material_id")
  chunkIndex  Int                          @map("chunk_index")
  text        String                       @db.Text
  pageStart   Int?                         @map("page_start")
  pageEnd     Int?                         @map("page_end")
  charCount   Int                          @default(0) @map("char_count")
  contentHash String                       @map("content_hash")
  /// pgvector column — dimension fixed by migration to match AI_EMBEDDING_DIMENSIONS (default 768).
  embedding   Unsupported("vector")?
  createdAt   DateTime                     @default(now()) @map("created_at")

  document AiDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([materialId])
  @@index([documentId])
  @@map("ai_document_chunks")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

/// AI-4 student assistant conversation (owner-scoped).
model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String        @db.Text
  grounding      String?
  citationsJson  Json?         @map("citations_json")
  toolsUsedJson  Json?         @map("tools_used_json")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// AI-5 admin MCQ verification lifecycle (advisory — never mutates Question).
enum AiVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum AiVerificationIssueType {
  NONE
  AMBIGUOUS
  POSSIBLE_KEY_ISSUE
  MULTIPLE_PLAUSIBLE_ANSWERS
  INSUFFICIENT_INFORMATION
  EXPLANATION_ISSUE
  OPTION_QUALITY_ISSUE
}

/// Persistent AI review of an MCQ. Human approve/reject decides the REVIEW only.
model AiQuestionVerification {
  id                      String                   @id @default(uuid())
  questionId              String                   @map("question_id")
  status                  AiVerificationStatus     @default(PENDING)
  /// Official key at verification time (snapshot — never written back to Question).
  officialCorrectOptionId String                   @map("official_correct_option_id")
  /// SHA-256 of stem/options/key/explanation/publish/subject/difficulty at verify time.
  questionContentHash     String                   @map("question_content_hash")
  issueType               AiVerificationIssueType? @map("issue_type")
  confidence              Float?
  reasoning               String?                  @db.Text
  recommendation          String?                  @db.Text
  optionAnalysisJson      Json?                    @map("option_analysis_json")
  qualityFlagsJson        Json?                    @map("quality_flags_json")
  sourceSupportJson       Json?                    @map("source_support_json")
  /// Server-built RAG evidence metadata only (never model-invented citations).
  evidenceJson            Json?                    @map("evidence_json")
  grounding               String?
  provider                String?
  model                   String?
  createdByAdminId        String                   @map("created_by_admin_id")
  createdAt               DateTime                 @default(now()) @map("created_at")
  decidedByAdminId        String?                  @map("decided_by_admin_id")
  decidedAt               DateTime?                @map("decided_at")
  adminNote               String?                  @map("admin_note") @db.Text
  errorCode               String?                  @map("error_code")
  errorMessage            String?                  @map("error_message") @db.Text

  question  Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdBy User     @relation("AiVerificationCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("AiVerificationDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
  @@index([status, createdAt])
  @@index([questionId, questionContentHash, status])
  @@index([issueType, status])
  @@map("ai_question_verifications")
}
